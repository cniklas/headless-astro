---
import Layout from '@/layouts/Layout.astro'
import { getHomePage } from '@/api'

const page = await getHomePage()
const { slug, title, modified, lastEditor, content } = page
---

<Layout home {slug} {title} footer>
	<div class="content-wrapper">
		<h1 class="content-title">
			{title}
		</h1>
		<div class="content-update">
			aktualisiert am {modified}
			{lastEditor && <span class="inline-block">von {lastEditor}</span>}
		</div>

		<div id="content" class="mt-9 lg:mt-10" set:html={content} />
	</div>
</Layout>
